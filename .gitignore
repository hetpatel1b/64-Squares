# ==============================================================================
# 64 Squares — .gitignore
# ==============================================================================

# Build directories and generated build trees
build/
bin/
out/
CMakeUserPresets.json

# CMake temporary and generated artifacts
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.ninja
.ninja_deps
.ninja_log
compile_commands.json
CTestTestfile.cmake
Testing/

# Compiled object files, libraries, and executables
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk

# IDE and Editor configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.idea/
.vs/
*.sublime-project
*.sublime-workspace
*.user

# Operating System metadata
Thumbs.db
Desktop.ini
.DS_Store

# Temporary logs, test output, and crash dumps
*.log
*.tmp
*.dmp

# Local environment and secret configs
.env
*.local

# Saves directory: preserve directory tracking via .gitkeep, ignore runtime save games
saves/*
!saves/.gitkeep
